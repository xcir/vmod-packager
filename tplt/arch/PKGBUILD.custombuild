# Maintainer: Guillaume Quintard <guillaume.quintard@gmail.com>

pfx=%PFX%
name=%VMOD%
pkgname=%PKGNAME%
pkgver=%VRT%.%VER%
pkgrel=1
pkgdesc="%PFX%%VMOD% - %DESC%"
depends=(%REQUIRE%)
makedepends=()
arch=('x86_64')
source=("src.tgz")
license=('BSD')

package() {
    mkdir -p "$pkgdir%VMODDIR%/"
    install -m 0755 "$srcdir/%VMODDIR_REL%/"*.so "$pkgdir%VMODDIR%/"
}
