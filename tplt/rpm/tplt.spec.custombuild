%global debug_package %{nil}
%UNPACKAGED_TRACK%

Summary:	%PFX%%VMOD%
Name:		%PKGNAME%
Version:	%VRT%.%VER%
Release:	1%{?dist}
License:	See original VMOD source license file.

Source:	    vmod.tar.gz

Requires: %REQUIRE%

%description
Packed by vmod-packager

%prep
%setup -q -n vmp_build

%build

%install
mkdir -p %{buildroot}%VMODDIR%/
install -m 0755 %VMODDIR_REL%/*.so %{buildroot}%VMODDIR%/

%files
%VMODDIR%/*.so

%changelog
* %TIME% %PFX%%VMOD% <example@localhost> - %VRT%.%VER%
- Packaged by vmod-packager
